config_version=5

[application]

config/name="NovaGrid"
config/icon="res://assets/icons/NovaGrid-Godot-Icon-512.png"
run/main_scene="res://scenes/Welcome.tscn"
config/description="NovaGrid Cosmic Edition: native crystal puzzle, daily missions and Blockfall"

[autoload]

Session="*res://scripts/GameSession.gd"

[display]

window/size/viewport_width=432
window/size/viewport_height=960
window/size/window_width_override=432
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.017, 0.09, 1)

[physics]

common/physics_ticks_per_second=60

[gui]

common/snap_controls_to_pixels=true
